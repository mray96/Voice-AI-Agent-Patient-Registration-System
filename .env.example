# Use the Supabase transaction pooler URL for serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Required by POST /vapi/webhook. Configure a matching Vapi custom credential.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-value
VAPI_PUBLIC_KEY=replace-with-your-vapi-public-key
VAPI_ASSISTANT_ID=6d1dd7d7-6b4e-4314-94eb-e1099762dd2d

# Used only by the optional Vapi configuration workflow described in README.md.
VAPI_API_KEY=
GEMINI_API_KEY=
API_BASE_URL=http://localhost:3000
